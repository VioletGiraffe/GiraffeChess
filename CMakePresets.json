{
	"version": 3,
	"configurePresets": [
		{
			"name": "base",
			"hidden": true,
			"generator": "Ninja",
			"binaryDir": "${sourceDir}/build/${presetName}",
			"architecture": { "value": "x64", "strategy": "external" }
		},
		{ "name": "debug", "inherits": "base", "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" } },
		{ "name": "release", "inherits": "base", "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" } }
	],
	"buildPresets": [
		{ "name": "debug", "configurePreset": "debug" },
		{ "name": "release", "configurePreset": "release" }
	],
	"testPresets": [
		{ "name": "base", "hidden": true, "output": { "outputOnFailure": true } },
		{ "name": "debug-quick", "inherits": "base", "configurePreset": "debug", "filter": { "include": { "label": "quick" } } },
		{ "name": "debug-full", "inherits": "base", "configurePreset": "debug", "filter": { "include": { "label": "full" } } },
		{ "name": "release-quick", "inherits": "base", "configurePreset": "release", "filter": { "include": { "label": "quick" } } },
		{ "name": "release-full", "inherits": "base", "configurePreset": "release", "filter": { "include": { "label": "full" } } }
	]
}
